ANTHROPIC_API_KEY="enter your key"
VOYAGE_API_KEY=

# Day 13 — local Postgres/pgvector (docker-compose.yml + spring.datasource.* in application.yml).
# These are LOCAL DEV credentials, not secrets: both files already default to the same values, so a
# fresh clone works with this block left commented out. Set them when you want something else.
# POSTGRES_DB=aura
# POSTGRES_USER=aura
# POSTGRES_PASSWORD=aura
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
