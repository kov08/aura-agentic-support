<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>org.aura</groupId>
    <artifactId>aura</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>aura</name>
    <description>aura</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring MVC + embedded Tomcat + Jackson, for the @RestController HTTP seam.
             This promotes the app from a console runner to a web application. Version is
             managed by the spring-boot-starter-parent BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation (Jakarta) + Hibernate Validator, for @Valid/@NotNull-style
             constraint checking on incoming request DTOs. Version is managed by the
             spring-boot-starter-parent BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>2.40.1</version>
        </dependency>

        <!-- Day 9: Redis response cache (ADR-018). Auto-configures a StringRedisTemplate against
             spring.data.redis.* — no @Configuration/@Bean needed; ResolutionCache injects that
             template directly. Lettuce is the default client. Version managed by the
             spring-boot-starter-parent BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Resilience4j Spring Boot integration: brings the @Retry/@CircuitBreaker/
             @RateLimiter annotations plus the application.yml config binding
             (resilience4j.retry.instances.*, resilience4j.circuitbreaker.instances.*, ...).
             We use the spring-boot4 module, NOT the more commonly documented spring-boot3
             one — this project runs on spring-boot-starter-parent 4.1.0 (Spring Framework 7 /
             Jakarta EE 11), and spring-boot4:2.4.0 targets spring-boot-autoconfigure 4.x while
             spring-boot3 targets Boot 3.x. Version is pinned explicitly because Resilience4j
             is a third-party library not covered by the spring-boot-starter-parent BOM. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>2.4.0</version>
        </dependency>

        <!-- Spring AOP starter. Required — and easy to forget: the Resilience4j annotations
             above are applied through Spring AOP proxies. Without an AOP starter on the classpath
             the annotations are silently ignored: no build error, no retry, no circuit breaker —
             just wrong runtime behavior. NOTE: Spring Boot 4 renamed the classic
             spring-boot-starter-aop to spring-boot-starter-aspectj (the old coordinate stops at
             the 4.0.0-M2 milestone and is absent from the 4.1.0 BOM). This starter pulls in
             spring-aop + aspectjweaver, which is what the proxies need. Version is managed by the
             spring-boot-starter-parent BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- Lombok supplies the @Slf4j annotation used by ConversationService.
             Version is managed by the spring-boot-starter-parent BOM. optional=true
             keeps it off the runtime classpath of downstream consumers (it's a
             compile-time annotation processor only). -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Day 11 (TASK 2) — integration-test dependencies, all test-scope. -->

        <!-- MockWebServer: a REAL local HTTP server the AnthropicClient talks to over the wire, so the
             integration tests exercise the SDK's actual transport (JSON (de)serialization, per-request
             timeout, connection handling) instead of a Mockito stub at the Java boundary (D1a). NOT
             managed by the spring-boot BOM, so the version is pinned: 4.12.0 is the last okhttp3-namespaced
             MockWebServer (package okhttp3.mockwebserver); okhttp 5 renamed it to mockwebserver3. -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>4.12.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers + Spring Boot: real Redis in a container so the Day 9 cache layer runs for
             real under test. spring-boot-testcontainers brings @ServiceConnection (auto-wires
             spring.data.redis.* to the container); junit-jupiter brings @Testcontainers/@Container.
             Versions managed by the spring-boot BOM (Testcontainers 2.0.5). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- NOTE: Testcontainers 2.x renamed every module with a `testcontainers-` prefix, so the
             JUnit 5 integration is `testcontainers-junit-jupiter` (was `junit-jupiter` in TC 1.x).
             It pulls in the Testcontainers core transitively. Version managed by the BOM (2.0.5). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Redis container module. There is NO official `org.testcontainers:redis` module; Spring Boot
             4.1's BOM instead manages the community `com.redis:testcontainers-redis` (2.2.4), which
             gives a first-class RedisContainer with Spring Boot @ServiceConnection support — cleaner
             and more robust than a bare GenericContainer wired by hand. Version managed by the BOM,
             curated to be compatible with Testcontainers 2.0.5. -->
        <dependency>
            <groupId>com.redis</groupId>
            <artifactId>testcontainers-redis</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Register Lombok as an annotation processor explicitly. With the newer compiler
                 plugin, simply having Lombok on the classpath no longer triggers processing, so
                 @Slf4j wouldn't generate the `log` field without this path. Version is omitted —
                 it's resolved from the spring-boot-starter-parent dependency management. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Keep Lombok out of the repackaged fat jar — it's compile-time only. -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Day 10 (D1a): evals are NOT unit tests — they measure model judgment, hit the live
                 Anthropic API, cost money, and their scores are allowed to dip without failing the
                 build. So the default `mvn test` EXCLUDES the JUnit5 "eval" tag: it runs only the
                 fast, free, offline unit + integrity + scorer tests. The `evals` profile below
                 inverts this to run ONLY the eval group. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>eval</excludedGroups>
                </configuration>
            </plugin>

            <!-- Day 11 (TASK 2/8) — integration tests (*IT) run under Failsafe in the `verify` phase,
                 kept OUT of the fast Surefire `test` phase (Surefire's default patterns are *Test/Tests,
                 which never match *IT). They start a real Redis container (Testcontainers, needs Docker)
                 and a local MockWebServer, so they are slower and have a hard Docker prerequisite.

                 No API-key wiring is needed here: key presence is governed entirely by the validated
                 aura.anthropic.api-key property, which the "test" profile defaults to ${ANTHROPIC_API_KEY:test-key}
                 — a dummy when absent (all IT calls go to MockWebServer, which never checks auth). One rule,
                 no Failsafe-vs-config branch to drift. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!-- REQUIRED on a Spring Boot project, and silently broken without it. Failsafe
                         runs AFTER `package`, and once the project artifact exists it prefers that jar
                         over target/classes — but spring-boot-maven-plugin's `repackage` has by then
                         rewritten the jar into an executable fat jar whose application classes live
                         under BOOT-INF/classes. That layout is invisible to a plain classpath, so every
                         *IT dies with NoClassDefFoundError on the first application class it touches
                         (observed: org/aura/aura/chunker/DocumentChunker). Pointing Failsafe back at
                         the exploded output directory is the documented fix. -->
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>

                    <!-- Day 12 — the same law the eval tag established for Surefire, now on the
                         integration side. SemanticSearchDemoIT is an *IT (so Surefire skips it) but it
                         is NOT a build gate: it hits the live Voyage API, costs money per run, and its
                         real output is a ranked table a human reads. Tagging it "manual" and excluding
                         that group keeps `mvn verify` free, offline-except-for-Docker, and safe to run
                         on a machine with no VOYAGE_API_KEY. The `demo` profile below inverts it. -->
                    <excludedGroups>manual</excludedGroups>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- `mvn test -Pevals` runs ONLY the eval group (the golden-set runner) and nothing else.
             It needs a live ANTHROPIC_API_KEY.

             combine.self="override" is load-bearing: without it Maven MERGES this configuration into
             the base plugin config, so the base's <excludedGroups>eval</excludedGroups> survives
             alongside this <groups>eval</groups> — and an excluded group beats an included one, so
             Surefire selects zero tests (observed). "override" makes this block REPLACE the base
             config outright, dropping the inherited exclusion. -->
        <profile>
            <id>evals</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration combine.self="override">
                            <groups>eval</groups>
                            <!-- REQUIRED: Surefire only discovers classes matching its default name
                                 patterns (*Test, *Tests, Test*, *TestCase). The runner is deliberately
                                 named EvalRunner (it is a harness, not a unit test), which matches none
                                 of them — so without this include, <groups>eval</groups> filters an
                                 empty candidate set and 0 tests run (observed). This include makes
                                 EvalRunner a candidate; the eval tag then selects it. -->
                            <includes>
                                <include>**/evals/EvalRunner.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- `mvn verify -Pdemo` runs ONLY the manual group — today that is SemanticSearchDemoIT. It
             needs a live VOYAGE_API_KEY and makes real (billable) embedding calls.

             combine.self="override" for the same load-bearing reason as the evals profile: without it
             Maven MERGES this into the base Failsafe config, the base's <excludedGroups>manual</…>
             survives alongside this <groups>manual</groups>, and an excluded group beats an included
             one — zero tests selected. "override" replaces the base config outright.

             Surefire is silenced here so the demo run does not also re-execute the whole unit suite:
             the point of -Pdemo is the ranked table, not a second opinion on the fast tests. -->
        <profile>
            <id>demo</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration combine.self="override">
                            <!-- Repeated, not inherited: "override" REPLACES the base configuration
                                 wholesale, so dropping this line would restore the fat-jar classpath
                                 bug for exactly the profile that needs to run an IT. -->
                            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                            <groups>manual</groups>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration combine.self="override">
                            <skipTests>true</skipTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
