<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>org.aura</groupId>
    <artifactId>aura</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>aura</name>
    <description>aura</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring MVC + embedded Tomcat + Jackson, for the @RestController HTTP seam.
             This promotes the app from a console runner to a web application. Version is
             managed by the spring-boot-starter-parent BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation (Jakarta) + Hibernate Validator, for @Valid/@NotNull-style
             constraint checking on incoming request DTOs. Version is managed by the
             spring-boot-starter-parent BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>2.40.1</version>
        </dependency>

        <!-- Day 9: Redis response cache (ADR-018). Auto-configures a StringRedisTemplate against
             spring.data.redis.* — no @Configuration/@Bean needed; ResolutionCache injects that
             template directly. Lettuce is the default client. Version managed by the
             spring-boot-starter-parent BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Resilience4j Spring Boot integration: brings the @Retry/@CircuitBreaker/
             @RateLimiter annotations plus the application.yml config binding
             (resilience4j.retry.instances.*, resilience4j.circuitbreaker.instances.*, ...).
             We use the spring-boot4 module, NOT the more commonly documented spring-boot3
             one — this project runs on spring-boot-starter-parent 4.1.0 (Spring Framework 7 /
             Jakarta EE 11), and spring-boot4:2.4.0 targets spring-boot-autoconfigure 4.x while
             spring-boot3 targets Boot 3.x. Version is pinned explicitly because Resilience4j
             is a third-party library not covered by the spring-boot-starter-parent BOM. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>2.4.0</version>
        </dependency>

        <!-- Spring AOP starter. Required — and easy to forget: the Resilience4j annotations
             above are applied through Spring AOP proxies. Without an AOP starter on the classpath
             the annotations are silently ignored: no build error, no retry, no circuit breaker —
             just wrong runtime behavior. NOTE: Spring Boot 4 renamed the classic
             spring-boot-starter-aop to spring-boot-starter-aspectj (the old coordinate stops at
             the 4.0.0-M2 milestone and is absent from the 4.1.0 BOM). This starter pulls in
             spring-aop + aspectjweaver, which is what the proxies need. Version is managed by the
             spring-boot-starter-parent BOM. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- Lombok supplies the @Slf4j annotation used by ConversationService.
             Version is managed by the spring-boot-starter-parent BOM. optional=true
             keeps it off the runtime classpath of downstream consumers (it's a
             compile-time annotation processor only). -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Register Lombok as an annotation processor explicitly. With the newer compiler
                 plugin, simply having Lombok on the classpath no longer triggers processing, so
                 @Slf4j wouldn't generate the `log` field without this path. Version is omitted —
                 it's resolved from the spring-boot-starter-parent dependency management. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Keep Lombok out of the repackaged fat jar — it's compile-time only. -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
